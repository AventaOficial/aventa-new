NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AVENTA_EXPECTED_SUPABASE_REF=oojshofrpbfwsiypcecr
AVENTA_SUPABASE_TARGET=staging
AVENTA_DEPLOYMENT_SURFACE=staging
DISTRIBUTION_ENGINE_ENABLED=false
