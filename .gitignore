# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Worker packages install locally (GHA/CI also npm install); never commit them.
workers/**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/e2e/results.json
/e2e/.fixture.json

# next.js
/.next/
/out/

# production
/build
browser-extension/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.staging.local.example

# Migraciones y esquema: no subir al repo público (mantener copia privada si hace falta)
/supabase/migrations/

# vercel
.vercel

# Cursor IDE (preferencias locales del editor)
.cursor/

# Supabase CLI cache (ref del proyecto; no subir)
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Volcado local para análisis externo (muy grande)
/Codigo_Completo.txt
/AVENTA_CONTEXT.md

# Artefactos locales de migraciones / audits (snapshots, dry-runs)
/tmp/
/scripts/_s55_reports/
/scripts/_smoke-gate-v2-discovery.json

.vercel
.env*.local
.env.vercel.check

# Research / competitive offer corpora (local-only; never push)
docs/SYSTEMS/AVENTA_OFFER_STANDARD_v1.md
docs/SYSTEMS/AVENTA_OFFER_CORPUS_v1.md

# Private research (competitive / offer corpora) — never push
docs/_private/
docs/SYSTEMS/AVENTA_OFFER_STANDARD_v1.md
docs/SYSTEMS/AVENTA_OFFER_CORPUS_v1.md
docs/hse/competitive/
docs/SYSTEMS/RESEARCH_supply_intelligence_engine.md
docs/SYSTEMS/CURSOR_MARKETPLACE_AUDIT.md

