{
  "manifest_version": 3,
  "name": "AVENTA — Cazar oferta",
  "version": "1.1.0",
  "description": "Publica ofertas de Amazon y Mercado Libre en AVENTA con un clic.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://amazon.com/*",
    "https://www.amazon.com.mx/*",
    "https://amazon.com.mx/*",
    "https://*.amazon.com/*",
    "https://*.amazon.com.mx/*",
    "https://www.mercadolibre.com.mx/*",
    "https://mercadolibre.com.mx/*",
    "https://articulo.mercadolibre.com.mx/*",
    "https://www.mercadolibre.com/*",
    "https://mercadolibre.com/*",
    "https://*.mercadolibre.com.mx/*",
    "https://*.mercadolibre.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://aventaofertas.com/*",
      "https://*.aventaofertas.com/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cazar oferta en AVENTA"
  },
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://amazon.com/*",
        "https://www.amazon.com.mx/*",
        "https://amazon.com.mx/*",
        "https://*.amazon.com/*",
        "https://*.amazon.com.mx/*",
        "https://www.mercadolibre.com.mx/*",
        "https://mercadolibre.com.mx/*",
        "https://articulo.mercadolibre.com.mx/*",
        "https://www.mercadolibre.com/*",
        "https://mercadolibre.com/*",
        "https://*.mercadolibre.com.mx/*",
        "https://*.mercadolibre.com/*"
      ],
      "js": ["dist/content/extract.js"],
      "run_at": "document_idle"
    }
  ]
}
